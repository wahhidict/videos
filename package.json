{
  "name": "motion-studio-ai-pro",
  "private": true,
  "version": "3.0.0",
  "description": "استوديو الحركة الذكي — تطبيق موشن جرافيك عربي بسيط ومجاني",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @msaipro/web",
    "build": "npm run build --workspace @msaipro/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @msaipro/core && npm run test --workspace @msaipro/web",
    "e2e:render": "tsx e2e/render-e2e.mts",
    "e2e:browser": "node apps/web/e2e/e2e.mjs",
    "desktop:dev": "npm run tauri --workspace @msaipro/desktop dev",
    "desktop:build": "npm run tauri --workspace @msaipro/desktop build"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
